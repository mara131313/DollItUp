<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="Magazin online dedicat vânzării produselor precum păpuși și accesorii pentru acestea.">
        <meta name="keywords" content="">
        <meta name="author" content="Vraciu Mara Alina">
        <meta name="msapplication-TileColor" content="#FFC0CB">
        
        <title>DollItUp</title>
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>
    <body>
        <header class="c1" id="titlu" >
            <h1 style="color: #573851;"><span>DollItUp</span></h1>
            <%- include("../fragmente/header") %>
        </header>
    <main>
        <section>
            <h2>Pagină produs</h2>
            <article id="art-produs">
                <h3><span class="nume"><%- locals.prod.nume %></span></h3>
                <p>Pret: <span class="pret"><%- locals.prod.pret %> </span></p>
                <p>Descriere: <span class="descriere"><%- locals.prod.descriere %> </span></p>
                <p>Material: <span class="material"><%- locals.prod.material %> </span></p>
                <p>Dimensiune: <span class="dimensiune"><%- locals.prod.dimensiune %> </span></p>
                <p>Categorie: <span class="categorie"><%- locals.prod.categorie %> </span></p>
                <p>Confecționarea este vegană: <span class="vegan"><%- locals.prod.vegan %> </span></p>
                <p>Data adăugare: <span class="data_adaugare"><%- locals.prod.data_adaugare %> </span></p>
                <figure class="imag-produs">
                    <img  src="/resurse/imagini/produse/<%- locals.prod.imagine %>" alt="[imagine <%- locals.prod.nume %>]" />
                </figure>    
            </article>
        </section>
    </main>
    <%- include("../fragmente/footer") %>
    </body>
</html>