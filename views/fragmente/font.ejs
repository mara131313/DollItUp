<svg width="0" height="0">
    <filter id="wave">
      <feTurbulence type="turbulence" baseFrequency="0.02 0.1" numOctaves="2" result="turbulence"/>
      <feDisplacementMap in2="turbulence" in="SourceGraphic" scale="10" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
    <filter id="wave-animated">
      <feTurbulence type="turbulence" baseFrequency="0.04 0.15" numOctaves="3" result="turbulence">
        <animate attributeName="baseFrequency" dur="2s" values="0.02 0.1;0.04 0.15;0.02 0.1" repeatCount="indefinite"/>
      </feTurbulence>
      <feDisplacementMap in2="turbulence" in="SourceGraphic" scale="20" xChannelSelector="R" yChannelSelector="G"/>
    </filter>
</svg>